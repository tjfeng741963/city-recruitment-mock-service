# 城市招聘 · 服务端（中心部署）环境配置模板
#
# 用法（在 deploy/server 目录执行）：
#   bash install.sh
# install.sh 检测到没有 .env 时，会复制本文件为 .env，并自动生成
#   APP_JWT_SECRET / APP_SEED_ADMIN_PASSWORD / POSTGRES_PASSWORD
# 三个密钥（替换下面的 __CHANGE_ME__）。重复执行不会覆盖已有 .env。
#
# 手工部署的话：cp .env.example .env 后把三个 __CHANGE_ME__ 换掉，再
#   docker compose up -d --build
#
# ⚠️ 本文件只放占位符，不要把真实密钥写进来（.env 已被 .gitignore 忽略）。

# ── 对外入口 ──────────────────────────────────────────────────
# nginx 监听端口；80 之外要改这里，例如 8080。健康检查也读这个值。
HTTP_PORT=80

# ── PostgreSQL ────────────────────────────────────────────────
# 容器内连接串由 docker-compose.yml 用下面三项拼出，无需在这里写 APP_DATABASE_URL。
POSTGRES_USER=recruit
POSTGRES_DB=city_recruitment
# install.sh 会自动替换成随机密码
POSTGRES_PASSWORD=__CHANGE_ME__

# ── 应用运行 ──────────────────────────────────────────────────
# production / staging / dev，会出现在 /healthz 的 env 字段里
APP_ENV=production
# 容器内固定监听 0.0.0.0:8090（Dockerfile CMD 已写死），无需配 APP_HOST/APP_PORT
APP_SQL_ECHO=false

# ── 首次启动的管理员（仅用户表为空时创建）─────────────────────
APP_SEED_ADMIN_USERNAME=admin
# install.sh 会自动替换成随机密码
APP_SEED_ADMIN_PASSWORD=__CHANGE_ME__

# ── JWT 签名密钥 ──────────────────────────────────────────────
# install.sh 会自动替换成 32 字节随机 hex
APP_JWT_SECRET=__CHANGE_ME__
APP_ACCESS_TOKEN_MINUTES=480

# ── 设备自注册（可选）─────────────────────────────────────────
# 留空 = 关闭自注册入口（POST /api/v1/devices/register 返回 503）。
# 多客户端批量接入时填一串随机字符，客户端 agent/config.json 的 register_key 与之保持一致，
# 首次启动即可自动换取 device_token，省掉手工建码。
APP_REGISTER_KEY=

# ── 服务间令牌（Node 侧自动回复链路用）───────────────────────
# 与 bridge/Node 侧共享的卷文件，启动时若无则自动生成。
# 容器部署保持默认路径即可；单机/裸机部署可显式指定。
APP_KB_SERVICE_TOKEN=
APP_KB_SERVICE_TOKEN_FILE=/run/kb/service-token

# ── 默认租户 ──────────────────────────────────────────────────
APP_DEFAULT_TENANT_NAME=默认租户
APP_DEFAULT_TENANT_SLUG=default

# ── 大模型（OpenAI 兼容中转站）───────────────────────────────
# 留空 Key 时自动降级为模板回复，不会阻塞客户消息。
# 换供应商只改这三项，代码不用动。
APP_LLM_BASE_URL=https://api.deepseek.com/v1
APP_LLM_API_KEY=
APP_LLM_MODEL=deepseek-chat
APP_LLM_TIMEOUT=30

# ── 后台任务 ──────────────────────────────────────────────────
# ⚠️ 同一套数据库只允许有一个实例跑 outbox/sync worker，
#    否则消息会被重复处理（多副本部署时必须只留一个 True）。
APP_OUTBOX_WORKER=true
APP_OUTBOX_INTERVAL=5
APP_SYNC_WORKER=true
APP_SYNC_INTERVAL=15
# 线索扫描：到点的 booked 标「待核实」，不向客户发消息。默认关，按顾问灰度。
APP_LEAD_WORKER=false
APP_LEAD_INTERVAL=300
# 设备离线判定：只读心跳，可常开。
APP_DEVICE_WORKER=true
APP_DEVICE_INTERVAL=30
APP_DEVICE_OFFLINE_AFTER=90

# ── 构建参数（可选）───────────────────────────────────────────
# 国内服务器拉 PyPI 慢时换成阿里云镜像：
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple/
# 镜像 tag，用于回滚到指定版本
IMAGE_TAG=latest
