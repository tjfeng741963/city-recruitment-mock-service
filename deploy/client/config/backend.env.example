# 城市招聘 · 后端本地配置模板
# 安装脚本会复制成 backend/.env；已存在则不覆盖。
# 改完需重启后端（关闭「后端 :8090」窗口，重新 start-all.bat）。

# ── 运行 ──────────────────────────────────────────────────────
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8090

# ── 数据库（SQLite，相对 backend/ 目录；首次启动自动建表）──────
APP_DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ── 首次启动的管理员（用户表为空时才会创建）──────────────────
# 交付前务必改成客户自己的账号密码，改完删掉 backend/data/app.db 才会重新建号。
APP_SEED_ADMIN_USERNAME=local-admin
APP_SEED_ADMIN_PASSWORD=local-demo-only

# ── JWT 签名密钥：交付前换成一串随机字符 ──────────────────────
APP_JWT_SECRET=change-me-before-delivery

# ── 大模型（OpenAI 兼容接口；不填 Key 则自动降级为模板回复）────
APP_LLM_BASE_URL=https://api.deepseek.com/v1
APP_LLM_API_KEY=
APP_LLM_MODEL=deepseek-chat
APP_LLM_TIMEOUT=30
